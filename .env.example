# === 默认（Anthropic 官方） ===
ANTHROPIC_API_KEY=your-api-key-here
AWESOME_CLAUDE_HOST=127.0.0.1
AWESOME_CLAUDE_PORT=9527
AWESOME_CLAUDE_MODEL=claude-sonnet-4-20250514
AWESOME_CLAUDE_MAX_TOKENS=4096
AWESOME_CLAUDE_LOG_LEVEL=INFO

# === 文件工具沙箱（可选） ===
# 文件系统工具的工作区根目录，默认服务启动时所在目录
# AWESOME_CLAUDE_WORKSPACE_DIR=.
# 单次读取 / 写入的字节上限
# AWESOME_CLAUDE_FS_MAX_READ=30000
# AWESOME_CLAUDE_FS_MAX_WRITE=100000

# === DeepSeek（可选，使用 Anthropic 兼容端点） ===
# 取消注释并填入 DeepSeek 平台（platform.deepseek.com）的 API key 与模型：
# ANTHROPIC_API_KEY=sk-xxx-your-deepseek-key
# AWESOME_CLAUDE_MODEL=deepseek-chat
# AWESOME_CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
